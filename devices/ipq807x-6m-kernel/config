#
# Linksys MX4200 v1 only: 512 MiB RAM, 6 MiB kernel partition.
# Keep REGULAR stack protection, enable native kernel BTF for CO-RE.
# The compressed FIT kernel must still fit into the 6 MiB partition.
#
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=n
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v1=y

# Preserve compressed swap on 512 MiB hardware.
CONFIG_PACKAGE_zram-swap=m
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_linksys_mx4200v1="zram-swap"

# Native BTF from the actual kernel build (not synthetic detached BTF).
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
